    {
      "name": "5. Resilience (stop the Event Service first!)",
      "description": "Before running this folder:  docker compose stop event-service\nAfter it:  docker compose start event-service\nWatch the retries and circuit breaker with:  docker compose logs -f registration-service",
      "item": [
        {
          "name": "1st create \u2192 503 after 4 retries",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/registrations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "registrations"
              ]
            },
            "description": "Timeout + retry with backoff: about 1.5s then 503 UNAVAILABLE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": {{eventId}},\n  \"student_name\": \"Dechen Wangmo\",\n  \"student_id\": \"02240444\",\n  \"email\": \"dechen@rub.edu.bt\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 503\", () => pm.response.to.have.status(503));"
                ]
