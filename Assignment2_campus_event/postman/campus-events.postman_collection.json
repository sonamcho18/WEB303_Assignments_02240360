{
  "info": {
    "name": "Campus Events \u2013 WEB303 Assignment 1",
    "description": "REST API of the Campus Events system. Every request goes to the API Gateway, which calls the Event Service and Registration Service over gRPC.\n\nRun the folders in order (or use the Collection Runner). IDs are saved automatically into collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "eventId",
      "value": "1"
    },
    {
      "key": "smallEventId",
      "value": "2"
    },
    {
      "key": "registrationId",
      "value": "1"
    },
    {
      "key": "keptRegistrationId",
      "value": "2"
    }
  ],
