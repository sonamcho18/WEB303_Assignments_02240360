# Configuration for docker compose. Docker Compose reads this file
# automatically; change values here, never in the Go code.

# ---- Ports ----
GATEWAY_PORT=8080
EVENT_SERVICE_PORT=50051
REGISTRATION_SERVICE_PORT=50052

# ---- Event Service database (event_db) ----
EVENT_DB_NAME=event_db
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=event_pass

# ---- Registration Service database (registration_db) ----
REGISTRATION_DB_NAME=registration_db
REGISTRATION_DB_USER=registration_user
REGISTRATION_DB_PASSWORD=registration_pass

# ---- Resilience: Registration Service -> Event Service ----
# timeout for each gRPC attempt
EVENT_CALL_TIMEOUT=2s
# retries after the first attempt (4 attempts total)
EVENT_MAX_RETRIES=3
# first backoff; doubles each retry (200ms, 400ms, 800ms)
EVENT_RETRY_BACKOFF=200ms
# consecutive failed calls before the breaker opens
CB_FAILURE_THRESHOLD=3
# how long the breaker stays open before a trial call
CB_OPEN_TIMEOUT=15s

# ---- Gateway ----
GATEWAY_REQUEST_TIMEOUT=15s
